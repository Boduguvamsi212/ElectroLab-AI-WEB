<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card_glass"
            android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Workstation Settings" android:textColor="@color/colorCyan"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Configure AI model parameters and data sampling intervals."
                android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Connection card -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card_glass"
            android:padding="16dp" android:layout_marginBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚙  Backend Connection" android:textColor="@color/colorCyan"
                android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Server URL"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_server_url" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="http://10.0.2.2:5000"
                    android:textColor="@color/colorCyanLight" android:fontFamily="monospace"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Connection Status"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_conn_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Checking…"
                    android:textColor="@color/colorTextMuted" android:fontFamily="monospace"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <Button android:id="@+id/btn_test_conn" android:layout_width="wrap_content"
                android:layout_height="40dp" android:text="Test Connection"
                android:textColor="@color/white" android:textStyle="bold"
                android:background="@drawable/btn_cyan_gradient"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- AI Model settings -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card_glass"
            android:padding="16dp" android:layout_marginBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧠  AI Model Configuration"
                android:textColor="@color/colorPurple" android:textSize="14sp"
                android:textStyle="bold" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="AI Model Version"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CorrosionNet-v2 (LSTM)"
                    android:textColor="@color/colorTextPrimary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Training Dataset"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ASTM-G5 / NACE TM0169"
                    android:textColor="@color/colorTextPrimary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Accuracy (Val)"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="97.3%"
                    android:textColor="@color/colorSuccess" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Session info -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card_glass"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔐  Session Information"
                android:textColor="@color/colorIndigo" android:textSize="14sp"
                android:textStyle="bold" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Logged in as"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_session_user" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Dr. Alex Carter"
                    android:textColor="@color/colorTextPrimary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Auth Token"
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp" />
                <TextView android:id="@+id/tv_token_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="✓ Active"
                    android:textColor="@color/colorSuccess" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
