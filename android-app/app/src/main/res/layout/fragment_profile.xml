<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Avatar + name card -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card_glass"
            android:padding="20dp" android:gravity="center" android:layout_marginBottom="16dp">

            <TextView android:layout_width="80dp" android:layout_height="80dp"
                android:text="👤" android:textSize="48sp" android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/tv_profile_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Dr. Alex Carter"
                android:textColor="@color/colorTextPrimary" android:textSize="22sp"
                android:textStyle="bold" />

            <TextView android:id="@+id/tv_profile_role" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Senior Chemist"
                android:textColor="@color/colorCyan" android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView android:id="@+id/tv_profile_institution" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="ElectroLab Research Center"
                android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Edit form -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card_glass"
            android:padding="16dp" android:layout_marginBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Edit Profile Information"
                android:textColor="@color/colorCyan" android:textSize="14sp" android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Full Name" android:textColor="@color/colorTextSecondary"
                android:textSize="11sp" android:layout_marginBottom="6dp" />
            <EditText android:id="@+id/et_name" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/shape_input_bg"
                android:textColor="@color/colorTextPrimary" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginBottom="16dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Role / Position" android:textColor="@color/colorTextSecondary"
                android:textSize="11sp" android:layout_marginBottom="6dp" />
            <EditText android:id="@+id/et_role" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/shape_input_bg"
                android:textColor="@color/colorTextPrimary" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginBottom="16dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Institution / Organization" android:textColor="@color/colorTextSecondary"
                android:textSize="11sp" android:layout_marginBottom="6dp" />
            <EditText android:id="@+id/et_institution" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/shape_input_bg"
                android:textColor="@color/colorTextPrimary" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginBottom="20dp" />

            <Button android:id="@+id/btn_save_profile" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Save Profile Changes"
                android:textColor="@color/white" android:textStyle="bold"
                android:background="@drawable/btn_cyan_gradient" />
        </LinearLayout>

        <!-- Logout -->
        <Button android:id="@+id/btn_logout" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Log Out"
            android:textColor="@color/colorDanger" android:textSize="14sp"
            android:background="@drawable/badge_danger" />

    </LinearLayout>
</ScrollView>
