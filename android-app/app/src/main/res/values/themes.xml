<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme — forced dark -->
    <style name="Theme.ElectroLab" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorCyan</item>
        <item name="android:colorBackground">@color/colorBgDeep</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:windowBackground">@color/colorBgDeep</item>
        <item name="android:statusBarColor">@color/colorBgDeep</item>
        <item name="android:navigationBarColor">@color/colorBgDeep</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="colorControlHighlight">#1006B6D4</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ElectroLab.Dialog</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.ElectroLab.Splash" parent="Theme.ElectroLab">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Alert Dialog -->
    <style name="ThemeOverlay.ElectroLab.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/colorCardBg</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
    </style>

    <!-- Card glass panel style -->
    <style name="Widget.ElectroLab.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorCardBg</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/colorBorderCyan</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary gradient button -->
    <style name="Widget.ElectroLab.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_cyan_gradient</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Outline/glass button -->
    <style name="Widget.ElectroLab.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/colorCyan</item>
        <item name="strokeColor">@color/colorCyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">@color/colorBorderCyan</item>
    </style>

    <!-- Purple accent button -->
    <style name="Widget.ElectroLab.Button.Purple" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_purple</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- TextInputLayout dark style -->
    <style name="Widget.ElectroLab.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/colorBgLight</item>
        <item name="boxStrokeColor">@color/colorBorderCyan</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextMuted</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
    </style>

    <!-- Section heading text -->
    <style name="TextAppearance.ElectroLab.SectionTitle" parent="android:TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorCyan</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Card subtitle text -->
    <style name="TextAppearance.ElectroLab.CardLabel" parent="android:TextAppearance">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Mono value text -->
    <style name="TextAppearance.ElectroLab.MonoValue" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorCyanLight</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
